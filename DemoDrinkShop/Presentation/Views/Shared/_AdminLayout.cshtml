<!DOCTYPE html>
@{
    bool editPage = ViewBag.Title != null && ((string)ViewBag.Title).StartsWith("Edit");
    string mainDivClass = editPage ? "card-shadow" : "card-shadow form-base";
}
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <link rel="stylesheet" href="~/css/site.css" />
        <link rel="stylesheet" href="~/css/myfonts.css" />
        <link rel="stylesheet" href="~/css/adminstyles.css" />

        @if(ViewBag.Title != null) 
        {
            <title>@ViewBag.Title</title>
        }
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

        <script src="~/lib/babel.min.js"></script>
        <script src="https://unpkg.com/react@16/umd/react.development.js" crossorigin="anonymous"></script>
        <script src="https://unpkg.com/react-dom@16/umd/react-dom.development.js" crossorigin="anonymous"></script>

        <script src="~/js/validator-fix.js"></script>
        <script src="~/js/adminImagesAjax.js"></script>

    </head>
<body onload="reassignValidation()">
        <div class="@mainDivClass">
            @if(ViewBag.Title != null) 
            {
                <div class="myformheader"><h4>@ViewBag.Title</h4></div>
            }
            <div>
                <a asp-action="Logout" asp-controller="Account">
                    <h4 class="serious-text" style="margin: 0;">Log Out</h4>
                </a>
            </div>
            
            <div id="temp-message" class="alert alert-success">@TempData["message"]</div>
           
            @RenderBody()
        </div>
    </body>
</html>
